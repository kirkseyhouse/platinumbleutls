# Fill through secure local configuration or Cloud Secret Manager. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
APP_ORIGIN=http://localhost:8080
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Local URLs above are development only; leave both unset in production.
# Production uses the attached workload identity and the private IAM connector.
INSTANCE_CONNECTION_NAME=
DB_NAME=
DB_IAM_USER=
TENANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
OPERATIONAL_MODE=hcp_coexistence
DOCUMENT_BUCKET=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox
HCP_API_KEY=
HCP_COMPANY_ID=
GOOGLE_CALENDAR_ID=
DRIVE_FOLDER_ID=
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=
NOTION_OPERATIONS_DATA_SOURCE_ID=
NOTION_EXPECTED_WORKSPACE_NAME=Platinum Bleu
# Leave empty until each connection and new use of data is approved.
SYNC_PROVIDERS=
QBO_WEBHOOK_VERIFIER_TOKEN=
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=
