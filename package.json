{
  "name": "platinum-bleu-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "provision": "node --env-file-if-exists=.env scripts/provision.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "check": "node scripts/check.js",
    "security:scan": "node scripts/secret-scan.js"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "1.12.0",
    "@google-cloud/storage": "^7.17.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "supertest": "^7.1.4"
  }
}
